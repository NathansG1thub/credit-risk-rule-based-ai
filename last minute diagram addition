        "def expert_system_decide(row):\n",
        "    # R1\n",
        "    if row['history'] == 'past_delay':\n",
        "        return 1, 'R1'\n",
        "\n",
        "    # R2\n",
        "    if row['checking'] in ['below_0', '0_to_200', 'none'] and row['employment'] == 'unemployed':\n",
        "        return 1, 'R2'\n",
        "\n",
        "    # R3\n",
        "    if row['instalment_rate'] >= 4 and row['savings'] in ['below_100', 'none_unknown']:\n",
        "        return 1, 'R3'\n",
        "\n",
        "    # R4\n",
        "    if row['history'] == 'critical_other_credits' and row['employment'] == 'unemployed' and row['amount'] > 5000:\n",
        "        return 1, 'R4'\n",
        "\n",
        "    # R5\n",
        "    if row['other_debtors'] == 'guarantor' and row['employment'] in ['lt_1y', '1_to_4y', '4_to_7y', 'gte_7y']:\n",
        "        return 0, 'R5'\n",
        "\n",
        "    # R6\n",
        "    if row['history'] == 'critical_other_credits' and row['employment'] in ['4_to_7y', 'gte_7y'] and row['amount'] <= 5000:\n",
        "        return 0, 'R6'\n",
        "\n",
        "    # R7\n",
        "    if (row['history'] in ['all_paid_this_bank', 'paid_duly'] and\n",
        "        row['checking'] in ['0_to_200', 'above_200'] and\n",
        "        row['employment'] in ['lt_1y', '1_to_4y', '4_to_7y', 'gte_7y'] and\n",
        "        row['amount'] <= 1000):\n",
        "        return 0, 'R7'\n",
        "\n",
        "    # R8\n",
        "    if (row['history'] in ['all_paid_this_bank', 'paid_duly'] and\n",
        "        row['checking'] in ['0_to_200', 'above_200'] and\n",
        "        row['employment'] in ['4_to_7y', 'gte_7y'] and\n",
        "        row['amount'] > 1000):\n",
        "        return 0, 'R8'\n",
        "\n",
        "    # R9\n",
        "    if row['history'] == 'no_credits' and row['employment'] in ['1_to_4y', '4_to_7y', 'gte_7y'] and row['amount'] <= 5000:\n",
        "        return 0, 'R9'\n",
        "\n",
        "    # DEFAULT\n",
        "    return 1, 'DEFAULT'\n",
        "\n",
        "# Apply the expert system to every applicant in the dataset\n",
