        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import confusion_matrix\n",
        "import numpy as np\n",
        "\n",
        "# Features = everything except the banned columns, the target, and the expert's own columns\n",
        "banned = [\"personal_status_sex\", \"foreign_worker\"]\n",
        "feature_cols = [c for c in df.columns\n",
        "                if c not in banned + [\"bad\", \"expert_decision\", \"rule_fired\"]]\n",
        "\n",
        "# One-hot encode: each category becomes a yes/no column\n",
        "X = pd.get_dummies(df[feature_cols])\n",
        "y = df[\"bad\"]\n",
        "print(\"Tree sees:\", X.shape, \"-> rows x yes/no questions\")"
      ],
