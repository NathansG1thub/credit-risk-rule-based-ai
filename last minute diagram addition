        "def cost(y_true, y_pred):\n",
        "    tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0, 1]).ravel()\n",
        "    return 5*fn + 1*fp\n",
        "\n",
        "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "rows = []\n",
        "\n",
        "for fold, (train_idx, test_idx) in enumerate(skf.split(X, y), start=1):\n",
        "    tree = DecisionTreeClassifier(max_depth=3, class_weight={0: 1, 1: 5},\n",
        "                                  random_state=42)\n",
        "    tree.fit(X.iloc[train_idx], y.iloc[train_idx])          # studies 800\n",
        "    tree_pred   = tree.predict(X.iloc[test_idx])            # exam on 200 unseen\n",
        "    expert_pred = df[\"expert_decision\"].iloc[test_idx].to_numpy()  # frozen judge, same exam\n",
        "\n",
        "    y_te = y.iloc[test_idx]\n",
        "    rows.append({\"fold\": fold,\n",
        "                 \"expert_cost\": cost(y_te, expert_pred),\n",
        "                 \"tree_cost\":   cost(y_te, tree_pred)})\n",
        "\n",
        "res = pd.DataFrame(rows)\n",
        "print(res)\n",
        "print(\"\\nTOTAL (all 1,000 applicants, each examined once):\")\n",
        "print(res[[\"expert_cost\", \"tree_cost\"]].sum())\n",
